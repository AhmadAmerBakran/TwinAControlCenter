{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {"files":["/favicon.ico","/index.html","/*.css","/*.js","/manifest.webmanifest"]}
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {"files":["/assets/**"]}
    }
  ],
  "dataGroups": [
    {
      "name": "api-health",
      "urls": ["/api/health"],
      "cacheConfig": {"strategy":"freshness","maxSize":1,"maxAge":"30s","timeout":"2s"}
    }
  ]
}
